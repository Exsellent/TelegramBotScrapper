{
    "dashboard": {
        "title": "Scrapper and Bot Metrics Dashboard",
        "timezone": "browser",
        "schemaVersion": 38,
        "version": 1,
        "refresh": "10s",
        "panels": [
            {
                "type": "graph",
                "title": "Scrape Duration (GitHub)",
                "id": 1,
                "datasource": { "type": "prometheus", "uid": "efb6ae24e9b0" },
                "targets": [
                    {
                        "expr": "histogram_quantile(0.50, sum(rate(scrape_duration_seconds_bucket{type=\"github\"}[1m])) by (le))",
                        "legendFormat": "p50 github",
                        "refId": "A"
                    },
                    {
                        "expr": "histogram_quantile(0.95, sum(rate(scrape_duration_seconds_bucket{type=\"github\"}[1m])) by (le))",
                        "legendFormat": "p95 github",
                        "refId": "B"
                    },
                    {
                        "expr": "histogram_quantile(0.99, sum(rate(scrape_duration_seconds_bucket{type=\"github\"}[1m])) by (le))",
                        "legendFormat": "p99 github",
                        "refId": "C"
                    }
                ],
                "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 }
            },
            {
                "type": "graph",
                "title": "Scrape Duration (StackOverflow)",
                "id": 2,
                "datasource": { "type": "prometheus", "uid": "efb6ae24e9b0" },
                "targets": [
                    {
                        "expr": "histogram_quantile(0.50, sum(rate(scrape_duration_seconds_bucket{type=\"stackoverflow\"}[1m])) by (le))",
                        "legendFormat": "p50 stackoverflow",
                        "refId": "A"
                    },
                    {
                        "expr": "histogram_quantile(0.95, sum(rate(scrape_duration_seconds_bucket{type=\"stackoverflow\"}[1m])) by (le))",
                        "legendFormat": "p95 stackoverflow",
                        "refId": "B"
                    },
                    {
                        "expr": "histogram_quantile(0.99, sum(rate(scrape_duration_seconds_bucket{type=\"stackoverflow\"}[1m])) by (le))",
                        "legendFormat": "p99 stackoverflow",
                        "refId": "C"
                    }
                ],
                "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 }
            },
            {
                "type": "graph",
                "title": "Scrapper Errors by Type",
                "id": 3,
                "datasource": { "type": "prometheus", "uid": "efb6ae24e9b0" },
                "targets": [
                    {
                        "expr": "scrapper_errors_total",
                        "legendFormat": "{{type}}",
                        "refId": "A"
                    }
                ],
                "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 }
            },
            {
                "type": "graph",
                "title": "Active Links by Type",
                "id": 4,
                "datasource": { "type": "prometheus", "uid": "efb6ae24e9b0" },
                "targets": [
                    {
                        "expr": "active_links_count",
                        "legendFormat": "{{type}}",
                        "refId": "A"
                    }
                ],
                "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 }
            },
            {
                "type": "graph",
                "title": "Bot Message Rate",
                "id": 5,
                "datasource": { "type": "prometheus", "uid": "efb6ae24e9b0" },
                "targets": [
                    {
                        "expr": "rate(bot_messages_total[1m])",
                        "legendFormat": "messages/sec",
                        "refId": "A"
                    }
                ],
                "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 }
            },
            {
                "type": "graph",
                "title": "Bot Errors",
                "id": 6,
                "datasource": { "type": "prometheus", "uid": "efb6ae24e9b0" },
                "targets": [
                    {
                        "expr": "bot_errors_total",
                        "legendFormat": "Total Errors",
                        "refId": "A"
                    }
                ],
                "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 }
            },
            {
                "type": "graph",
                "title": "Bot Update Processing Time",
                "id": 7,
                "datasource": { "type": "prometheus", "uid": "efb6ae24e9b0" },
                "targets": [
                    {
                        "expr": "histogram_quantile(0.50, sum(rate(bot_update_processing_bucket[1m])) by (le))",
                        "legendFormat": "p50",
                        "refId": "A"
                    },
                    {
                        "expr": "histogram_quantile(0.95, sum(rate(bot_update_processing_bucket[1m])) by (le))",
                        "legendFormat": "p95",
                        "refId": "B"
                    },
                    {
                        "expr": "histogram_quantile(0.99, sum(rate(bot_update_processing_bucket[1m])) by (le))",
                        "legendFormat": "p99",
                        "refId": "C"
                    }
                ],
                "gridPos": { "h": 8, "w": 24, "x": 0, "y": 48 }
            }
        ],
        "time": { "from": "now-15m", "to": "now" },
        "templating": {
            "list": []
        }
    },
    "overwrite": true
}
